{
  "name": "first-book",
  "library": "day-one",
  "steps": [
    {"snapshot": "home-empty"},
    {"click": "first-chest"},
    {"expect": {"sheet": true}},
    {"type": "Semester 1"},
    {"snapshot": "new-chest-prompt-typed"},
    {"key": "return"},
    {"expect": {"route": "chests", "chests": ["Semester 1"], "sheet": false}},
    {"snapshot": "home-one-chest"},
    {"click": "chest:Semester 1"},
    {"expect": {"route": "chest"}},
    {"snapshot": "chest-empty"},
    {"click": "first-shelf"},
    {"type": "Maths"},
    {"key": "return"},
    {"expect": {"shelves": ["Maths"], "sheet": false}},
    {"snapshot": "shelf-empty"},

    {"click": "slot:Maths:0"},
    {"expect": {"sheet": true}},
    {"type": "Week 1"},
    {"snapshot": "new-book-prompt"},
    {"key": "return"},
    {"expect": {"route": "book", "sheet": false, "typingIntoPage": true, "pageLabel": "Page 1 of 1"}},
    {"snapshot": "book-open-empty"},
    {"type": "Limits and continuity.\nA limit is the value f(x) approaches as x approaches a."},
    {"expect": {"pageText": "Limits and continuity.\nA limit is the value f(x) approaches as x approaches a."}},
    {"snapshot": "page-1-typed"},

    {"click": "page-forward"},
    {"expect": {"pageLabel": "Page 2 of 2", "pageText": "", "typingIntoPage": true}},
    {"type": "Squeeze theorem."},
    {"snapshot": "page-2-typed"},
    {"click": "page-backward"},
    {"expect": {"pageLabel": "Page 1 of 2", "pageText": "Limits and continuity.\nA limit is the value f(x) approaches as x approaches a."}},

    {"click": "done"},
    {"expect": {"route": "chest", "books": {"Maths": ["0:Week 1"]}}},
    {"expect": {"file": {"path": "Semester 1/Maths/Week 1.book/pages/002.md", "contains": "Squeeze theorem."}}},
    {"snapshot": "shelf-one-book"},
    {"click": "slot:Maths:0"},
    {"expect": {"route": "book", "pageLabel": "Page 1 of 2", "pageText": "Limits and continuity.\nA limit is the value f(x) approaches as x approaches a."}},
    {"click": "done"},

    {"click": "new-book:Maths"},
    {"type": "Week 2"},
    {"key": "return"},
    {"expect": {"route": "book", "typingIntoPage": true}},
    {"type": "Derivatives."},
    {"click": "sign"},
    {"expect": {"route": "book"}},
    {"snapshot": "sign-screen"},
    {"click": "sign-confirm"},
    {"expect": {"route": "chest", "books": {"Maths": ["0:Week 1", "1:Week 2"]}}},
    {"expect": {"file": {"path": "Semester 1/Maths/Week 2.book/book.json", "contains": "\"signed\" : true"}}},
    {"click": "slot:Maths:1"},
    {"expect": {"route": "book", "signed": true, "pageText": "Derivatives.", "typingIntoPage": false}},
    {"snapshot": "signed-book"},
    {"click": "done"},
    {"snapshot": "shelf-two-books"}
  ]
}
